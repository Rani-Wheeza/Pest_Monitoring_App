# Copy to .env (never commit .env). Defaults are fine for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Database: sqlite (default) or mssql for Azure SQL
DB_ENGINE=sqlite
# DB_HOST=pestmonitoring.database.windows.net
# DB_NAME=pestmonitoring
# DB_USER=
# DB_PASSWORD=

# Microsoft Entra ID (leave empty locally to skip token checks)
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=api://pest-monitoring

# Azure Blob Storage for photos (leave empty to store files locally)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=sightings

# Alerts
ALERT_THRESHOLD=10
NOTIFICATION_HUB_CONNECTION_STRING=
NOTIFICATION_HUB_NAME=
